# Canonical URL of this deployment. Use http://localhost:3000 with `vercel dev`.
PUBLIC_APP_URL=http://localhost:3000

# Temporary server-validated access gate. Replace these values before production.
APP_USERNAME=alexK
APP_PASSWORD=cal

# Generate independently with: openssl rand -base64 32
AUTH_SESSION_SECRET=

# Server-only integration ownership and storage.
INTEGRATION_OWNER_ID=karaman-family
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (PWA notifications). Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects the reminder dispatcher. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Guest invite email via Resend (https://resend.com). EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Family Calendar <invites@yourdomain.com>

# Optional for local AI Planner development. Production deployments use the
# short-lived VERCEL_OIDC_TOKEN that Vercel injects automatically.
AI_GATEWAY_API_KEY=
